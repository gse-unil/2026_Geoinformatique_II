# =============================================================================
# Liens Moodle — Géoinformatique II
# -----------------------------------------------------------------------------
# SOURCE DE VÉRITÉ des liens Moodle du cours. Ces liens changent chaque année
# (nouveau cours Moodle, nouveaux IDs d'activités). Mise à jour annuelle :
#   1. ouvrir le cours Moodle de l'année ;
#   2. reporter ici les nouvelles URLs (remplacer les valeurs vides) ;
#   3. commit + push — le déploiement se fait tout seul.
#
# Les variables d'environnement MOODLE_* (définies par ex. dans GitHub Actions :
# Settings → Secrets and variables → Actions → Variables) SURCHARGENT ce fichier.
#
# CONVENTION D'ACTIVITÉS PAR TP (affichées dans l'ordre sur chaque page TP) :
#   MOODLE_QUIZ_TPn       → quiz théorique du volet QGIS (à faire au fil du TP)
#   MOODLE_CODERUNNER_TPn → quiz de code Python (CodeRunner, après le notebook)
#   MOODLE_RENDU_*        → dépôts de fichiers (zip, PDF, lien OneDrive)
#
# Si le quiz théorique et le CodeRunner sont FUSIONNÉS en un seul quiz :
#   mettre la même URL dans les deux clés, OU laisser une clé vide — la ligne
#   correspondante du tableau d'évaluation est alors masquée automatiquement.
# =============================================================================

# Racine du cours Moodle (accueil : calendrier, évaluation, quiz, rendus)
MOODLE_URL=

# --- TP1 · Données spatiales ---
MOODLE_QUIZ_TP1=
MOODLE_CODERUNNER_TP1=
MOODLE_RENDU_TP1=

# --- TP2 · Requêtes & cartes ---
MOODLE_QUIZ_TP2=
MOODLE_CODERUNNER_TP2=
MOODLE_RENDU_TP2=              # carte PDF mise en page

# --- TP3 · Géotraitements vecteurs ---
MOODLE_QUIZ_TP3=https://moodle.unil.ch/mod/quiz/view.php?id=1736940
MOODLE_CODERUNNER_TP3=
MOODLE_RENDU_TP3_CARTE=https://moodle.unil.ch/mod/assign/view.php?id=1736942
MOODLE_RENDU_TP3_PROJET=https://moodle.unil.ch/mod/quiz/view.php?id=1736941

# --- TP4 · Analyse raster ---
MOODLE_QUIZ_TP4=
MOODLE_CODERUNNER_TP4=
MOODLE_RENDU_TP4_CARTES=https://moodle.unil.ch/mod/assign/view.php?id=1736952
MOODLE_RENDU_TP4_PROJET=https://moodle.unil.ch/mod/quiz/view.php?id=1736953

